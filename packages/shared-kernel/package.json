{
  "name": "@platform/shared-kernel",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    }
  },
  "typesVersions": {
    "*": {
      "pure": [
        "dist/pure.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b"
  }
}
