{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // ⚠️ 测试文件用 top-level await 与 import.meta（vitest 是 ESM）——沿用 build 的
    //    `module` 设置会报 32 条 TS1378 + 7 条 TS1343，那是**配置噪音不是代码问题**。
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": false,
    "incremental": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@platform/contracts": ["packages/contracts/src/index.ts"],
      "@platform/shared-kernel": ["packages/shared-kernel/src/index.ts"],
      "@platform/project": ["packages/modules/project/src/index.ts"],
      "@platform/sandbox": ["packages/modules/sandbox/src/index.ts"],
      "@platform/terminal": ["packages/modules/terminal/src/index.ts"],
      "@platform/credential": ["packages/modules/credential/src/index.ts"],
      "@platform/runtime": ["packages/modules/runtime/src/index.ts"],
      "@platform/image": ["packages/modules/image/src/index.ts"],
      "@platform/automation": ["packages/modules/automation/src/index.ts"],
      // ⚠️ pnpm workspace：这两个依赖装在**子包**的 node_modules 里，从仓库根解析不到。
      //    ⛔ 不是「类型缺失」，是解析路径的事 —— 指过去即可，别去装 @types 或写 d.ts。
      //    ⚠️ `drizzle.config.ts` 不在本配置的 include 里：它是**构建配置**不是测试代码，
      //    而它的 `drizzle-kit` 入口只在 `apps/api` 的解析上下文里成立。
      "dockerode": ["packages/modules/sandbox/node_modules/@types/dockerode/index.d.ts"]
    }
  },
  "include": ["acceptance/**/*.ts", "scripts/**/*.ts"]
}
