name: CI

on: [push, pull_request]

jobs:
  build-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - run: pnpm install --frozen-lockfile

      # ── static-checks (shared/09 §2.3, gate 1) ──
      - name: typecheck
        run: pnpm typecheck
      - name: lint (boundaries + no-restricted-syntax, --max-warnings=0)
        run: pnpm lint --max-warnings=0
      - name: prettier
        run: pnpm format:check

      # ⛔ 一个变量、三处默认值、两两不同 —— compose 那条不报错就起来了，但预制镜像
      #    没装 claude-code，每个 Task 现装 753 秒（脚本顶部有完整案情）。
      - name: 出厂镜像坐标一致性
        run: pnpm check:default-image

      # Fresh design-v2 scenarios: pure/service/current SQLite, then complete Nest protocols.
      # Source and execution evidence are separate; external Docker/BoxLite is not claimed.
      - name: design-v2 acceptance and actual execution report
        run: pnpm test:acceptance:report
      - name: external provider fixture capability declaration
        run: node scripts/check-fake-provider-caps.mjs
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: api-acceptance-results
          path: |
            reports/acceptance/
            acceptance/execution-report.json

      # ── build + openapi.json drift gate (09 §2.3) ──
      - name: build
        run: pnpm build
      - name: openapi.json drift
        run: |
          pnpm openapi:emit
          git diff --exit-code openapi.json
