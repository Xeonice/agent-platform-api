  "info": {
    "title": "Agent Platform API",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UnlockRequestDto": {
        "type": "object",
        "properties": {
          "passcode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "passcode"
        ]
      },
      "CreateSandboxDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "initialPrompt": {
            "type": "string"
          },
          "headless": {
            "type": "boolean"
          },
          "timeoutMinutes": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 30,
                "maximum": 30
              },
              {
                "type": "number",
                "minimum": 60,
                "maximum": 60
              },
              {
                "type": "number",
                "minimum": 120,
                "maximum": 120
              },
              {
                "type": "number",
                "minimum": 240,
                "maximum": 240
              }
            ]
          }
        },
        "required": [
          "projectId",
          "runtime"
        ]
      },
      "SandboxResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "scheduling",
              "preparing-workspace",
              "creating",
              "starting",
              "running",
              "idle",
              "stopping",
              "stopped",
              "failed",
              "destroying",
              "destroyed"
            ]
          },
          "headless": {
            "type": "boolean"
          },
          "timeoutMinutes": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 30,
                "maximum": 30
              },
              {
                "type": "number",
                "minimum": 60,
                "maximum": 60
              },
              {
                "type": "number",
                "minimum": 120,
                "maximum": 120
              },
              {
                "type": "number",
                "minimum": 240,
                "maximum": 240
              }
            ],
            "nullable": true
          },
          "idleTimeoutSec": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "waitingInput": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": false
          }
        },
        "required": [
          "id",
          "projectId",
          "runtime",
          "status",
          "headless",
          "timeoutMinutes",
          "idleTimeoutSec",
          "waitingInput",
          "version"
        ]
      },
      "DestroySandboxDto": {
        "type": "object",
        "properties": {
          "keepVolume": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "traceId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      }
    }
  }
}
