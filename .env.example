# ---- copy to .env (never commit .env) ----
#
# `pnpm start` / `pnpm db:migrate` load this via node's `--env-file-if-exists`.
# 优先级：**已经存在的 shell 环境变量胜过本文件** —— compose 的 `environment:`
# 与 CI 的 env 不会被本地 .env 盖掉，正是想要的方向。
#
# ⚠️ **三个**入口都要能读到同一份配置：`start` / `start:dev` / `db:migrate`。
# 少配一个的后果是"迁移落到一个库、服务开另一个库"，而两边都不报错。
# `start:dev` 是本地开发最常用的那条 —— 第一版只配了前两个，正好漏掉它。

# HTTP bind. Default binds to loopback only (shared/11 §3, audit P0-3).
# Changing to 0.0.0.0 exposes the instance to the LAN/public and MUST be explicit.
HOST=127.0.0.1
PORT=3000

# 外侧暴露由**别的东西**收住时，在这里写下那句话（**一句声明，不是一个开关**）。
#
# ⚠️ 它只在 HOST 不是 loopback 时才有意义。compose 形态下 `HOST=0.0.0.0` 是必须的
#    （容器里绑 loopback，外面那行 `ports:` 就转不进来），于是那条
#    「HTTP is bound to 0.0.0.0」WARN **每次启动都出现、每次都不代表出错** ——
#    而一条恒真的告警会训练人忽略告警，恰好废掉这条告警存在的全部理由。
# ⇒ 填了它：WARN 降为 INFO，并把这句话**原样**打进日志（可审计，日志里留下的是
#    运维方自己写的那句，不是平台替他做的假设）。留空：行为一字不变，照旧 WARN。
# ⚠️ 平台**验证不了**这句声明 —— 进程内看不见外侧发布在哪。改了 `ports:` 的人有责任
#    同时改这里，否则你亲手关掉的是一条安全告警。
HTTP_BIND_GATED_BY=

# Data root: workspaces / baselines / sqlite / master key live here (shared/11 §1.2).
# Host path MUST equal container path under DooD.
#
# ⛔ **这个相对路径只对「裸跑 pnpm start」有效。`docker compose` 会把本文件当成它自己的
#    变量文件读走**（compose 自动加载 ./.env），于是 `${DATA_ROOT}:${DATA_ROOT}` 展开成
#    `./data:data`，而容器侧挂载点必须是绝对路径 ⇒ 实测直接报：
#      Error response from daemon: invalid volume specification ...
#      invalid mount path: 'data' mount path must be absolute
#    ⇒ **要用 compose 就把这里改成绝对路径**（或给 compose 单独一份 env 文件）。
DATA_ROOT=./data

# SQLite file. **整行留着注释状态**（不设 = 回落到 $DATA_ROOT/platform.db）。
#
# ⚠️ 不要写成 `DATABASE_URL=`（空串）。代码是 `process.env.DATABASE_URL ?? <默认>`，
# `??` 只对 null/undefined 回落 —— **空串是有值的**，于是不走默认，better-sqlite3
# 拿到空串会开一个**匿名临时库**。表现：领域事件照发、工作区目录照建，但
# platform.db 根本不存在、列表端点永远回 []、创建流程停在「启动实例」，全程不报错。
# （本行此前就是 `DATABASE_URL=`，等于把这个坑随模板一起发出去。）
# DATABASE_URL=/abs/path/to/platform.db

# ⚠️ 沙箱默认镜像 —— **必须显式给**，这是坑二。
# 平台内置默认是 `alpine:3.20`（见 SandboxApplicationService），而 alpine 里没有
# 沙箱内 API、没有 tmux、也没有常驻进程会立刻退出 ⇒ 容器一退 `NetworkSettings.Ports`
# 就空，第一个 Task 直接死在 `agent port 8080 is not published`。
# 不设这一行，"copy .env.example to .env" 走完，人还是在坑里。
#
# ⚠️⚠️ 光设还不够，**必须指向一张真的装了 tmux 的镜像**，而且平台要认得它。
# 平台预制镜像的构建脚本在 api/images/platform-sandbox（= 上游 + claude-code + 升级
# 后的 codex）。上游那张 `agent-infra/sandbox` 其实也带 tmux，平台内置的已知镜像表
# 认得它 —— 但它没有预装 claude-code，claude-code 的 Task 会现装 12.5 分钟。
#
# ⚠️ 2026-08 变更：以前这里**必须**是平台自建的那张，因为准入检查看的是镜像上的
#    `platform.tmux` 标签，而上游不会打我们发明的标签 —— 于是平台被迫维护一层
#    「FROM 上游 + 3 个 LABEL、零字节新层」的中间镜像 `platform/base`，代价是 13GB
#    的 pull/push 和一个**必须自建的 registry**（Docker 一停整条链断）。那句声明现在
#    搬到了下面的 SANDBOX_DEFAULT_IMAGE_TMUX / 平台内置已知镜像表。
#
# ⛔ **这里此前写着「aio 本地 build 的镜像可以直接用，不必 push」—— 那是错的**
#    （2026-08-29 真 Linux 实测推翻）。镜像要过**两道**关，查的是两个地方：
#      ① 注册/开机播种 → `OciImageSpecProvider` 走 **registry 的 HTTP API**，
#         **从不问 docker daemon**（平台只注册了 `oci` 这一个 ImageSpecProvider）
#      ② 起容器       → 这一步才用 docker 的本机镜像库
#    只存在于本机、没 push 过的镜像**过不了第 ①**关，于是平台「一张预制镜像都没有」，
#    建不了 Task。实测：`SANDBOX_DEFAULT_IMAGE=platform/sandbox:dev` ⇒
#    `registry registry-1.docker.io answered 401`。
#    ⇒ **两档都需要一个够得着的 registry**，详见 api/images/README.md。
#
# ⚠️⚠️ **仓库名必须写成 `platform/sandbox`（斜杠），不是 `platform-sandbox`（连字符）。**
#    连字符那个是**构建目录名**（`api/images/platform-sandbox`），而平台内置的已知镜像表
#    匹配的是仓库名。照目录名 `docker build -t <registry>/platform-sandbox:v1` 建出来的
#    镜像会在开机播种时被拒（`IMAGE_TMUX_MISSING`），随后任何自定义镜像注册都会撞上
#    「平台还没有可用的预制镜像作为血统基准」。2026-08-29 真机踩过一次。
#    （错误信息现在会自己点出这件事，但看到它已经是十分钟以后了。）
#
# ⚠️ 明文（http）registry 默认**只有** host 写成 `localhost` / `127.0.0.1` / `[::1]`
#    才连得上 —— scheme 是按 host 名硬判的（`oci-registry.client.ts`），其余一律 https。
#    其余明文 registry 用下面的 IMAGE_REGISTRY_INSECURE_HOSTS 显式放行。
# ⛔ **这一行的默认值在 `docker compose` 部署下不能照抄**：api 在容器里，
#    `localhost:5001` 是**容器自己的** loopback。compose 下要么用一个容器够得着的
#    TLS registry，要么给本机明文 registry 一个**宿主与容器都解析得到同一个东西**的
#    host:port 并列进 IMAGE_REGISTRY_INSECURE_HOSTS（配方见 api/images/README.md）。
#
# ⚠️ 下面这个默认值指向一个**你多半没有**的自建 registry —— 直接 `cp .env.example .env`
#    跑起来会看到 `ImageSeeder ... could not be seeded`，平台起得来但建不了 Task。
#    tag 按你实际构建并 push 出来的那个填。
SANDBOX_DEFAULT_IMAGE=localhost:5001/platform/sandbox:v2

# 运维方对上面那张镜像的一句**声明**：它装了 tmux 吗（04 §7 ★血统）。
#
# ⚠️ 留空时平台查内置的已知镜像表（`agent-infra/sandbox` / `platform/sandbox`，
#    含内网 mirror —— 匹配的是 `<registry>/` 之后那一段）。两条都不满足 ⇒ 开机播种
#    **响亮失败**，而不是悄悄放过：这条防的是「SANDBOX_DEFAULT_IMAGE 被填成一张随便
#    的 alpine」。
# ⚠️ **它防不了谎报**，也从来不打算防：一张删掉 tmux 的镜像照样能被声明成 true。
#    谎报由运行期沙箱内那次 `command -v tmux` 抓（⇒ IMAGE_CONTRACT_VIOLATION）。
# 自建 / 改过名 / 内网 mirror 且平台认不出时，确认它真的装了 tmux 后设 true。
SANDBOX_DEFAULT_IMAGE_TMUX=

# ── 按档覆盖预制镜像（ADR 决策 C）——**单档部署不用配，留空即可** ─────────────
#
# 两档的预制镜像不再是同一张：
#   aio 档     = 上游 AIO（自带 :8080 沙箱内 HTTP API，13GB）   api/images/platform-sandbox
#   boxlite 档 = 精简镜像（node:22-slim + tmux + CLI，1.25GB）  api/images/platform-boxlite
# boxlite 背着 aio 那张的代价是实测 **190 秒冷启动**，而那张镜像里的 HTTP 服务在
# boxlite 档位下一次都不会被调用。
#
# ⚠️ 语义是**覆盖**：不配 = 两档共用上面的 SANDBOX_DEFAULT_IMAGE（今天的行为，一字不差）。
# ⚠️ **两张镜像不能互换**：拿 boxlite 那张去跑 aio，会在「启动实例」处响亮超时
#    （那张里根本没有 agent）。平台会在建任务的门口就拦下来（IMAGE_PROVIDER_MISMATCH），
#    判据是血统 —— 这张镜像派生自哪一档的锚点。
# ⚠️ 配了几张，就有几个**血统锚点**，用户自定义镜像必须 FROM 其中一张。
#SANDBOX_AIO_IMAGE=localhost:5001/platform/sandbox:v2
#SANDBOX_BOXLITE_IMAGE=localhost:5001/platform/boxlite:v1

# boxlite 拉镜像用的 registry（本地起步时指向自建 registry）。
SANDBOX_BOXLITE_REGISTRY=localhost:5001

# ── 平台自己站在哪一侧（shared/11 §1.4）───────────────────────────────────────
#
# ⛔⛔ **不填 = 「api 裸跑在宿主上」。** 这是默认，也是 §1.3 实测全绿的那条路。
#
# 填一个 docker 用户自定义网络名 = 「**api 自己在容器里，而且就在这个网络上**」。
# 那时平台把沙箱容器也接进这个网络，并改用**容器名**当 agent 地址
# （`http://platform-aio-<sandboxId>:8080`，走 docker 内嵌 DNS），
# 同时 agent 端口**一个都不发布** —— 暴露面比默认那档还小。
#
# ⚠️ 不填而把 api 跑在容器里（DooD）会得到最难查的那种失败：沙箱容器
#    `Up (healthy)`、镜像播种成功、health 200，而**每一个 Task 都死在**
#      PROVIDER_UNAVAILABLE: in-sandbox agent at http://127.0.0.1:<port> did not become ready
#    —— 因为那个端口发布在**宿主**的 loopback 上，而 api 的 `127.0.0.1` 是它自己。
#    这与 §1.2「宿主路径 = 容器路径」是同一类问题的两面：DooD 下 api 说出口的每一个
#    坐标（路径、地址）都由**宿主**解析。
#
# ⚠️ **平台不去猜自己在不在容器里**（不看 `/.dockerenv`、不探测网关）。探测回答的是
#    「我像不像在容器里」，而真正的问题是「我说出口的地址对面解析得开吗」——那取决于
#    部署者怎么接的网。反例现成：`network_mode: host` 的 api 容器里 `/.dockerenv` 在，
#    而 loopback 那套坐标恰恰是对的。猜错的症状是「全绿 + 建不了 Task」。
#
# ⛔ **这里原本还有半句「配错的症状是一条指名道姓的错误」—— 那是假的**
#    （2026-08-30 真机实测推翻）：那条指名道姓的错误（`container … is not attached to …`）
#    只覆盖「沙箱容器不在网络上」，而沙箱容器是平台自己放进去的，那一半**填不错**。
#    填得错的是「**我自己也在这个网络里**」，而那一半当时一个字都没有检查。
#    实测：api 裸跑在宿主却填了这一行 ⇒ 沙箱容器 running/healthy、Ports={}、
#    agentOrigin = `http://platform-aio-<id>:8080`（名字对的），而宿主解析不了这个名字
#    ⇒ sandbox 卡在 `starting` **6 分钟以上不动，无错误、无超时、无日志**
#    —— 比它想修的那个 bug 还难查（那个至少还给一句 `did not become ready`）。
#
# ✅ **已补上（2026-08-30）：开机自检。** 填了这一行，平台在启动时就会证实后半句 ——
#    问 daemon「这个网络上有哪些容器、它们的地址是什么」，再与本进程自己持有的地址
#    取交集：交集非空 ⇒ 我就是那个容器；交集为空 ⇒ **开机就失败**，并把两侧证据和
#    两条出路（裸跑就删掉这一行 / 在容器里就把 api 也接上这个网络）打在错误里。
#    ⚠️ docker 问不到时它不拒绝启动，但会打一条 error 级别的「**我没能验证这一条**」——
#    这条配置唯一不许有的结论是「大概没事」。落点：
#    `packages/modules/sandbox/src/infrastructure/providers/docker/self-network-check.ts`。
#
# ⚠️ compose 用户注意：compose 默认给网络加项目名前缀，这里要写**docker 侧的真名**。
#    仓里的 `docker-compose.yml` 用 `networks.sandbox.name:` 关掉了前缀。
SANDBOX_DOCKER_NETWORK=

# 明文（http）registry 的允许名单，逗号分隔的 `host:port` —— 与 docker daemon 自己的
# `insecure-registries` 同形状、同语义。
#
# ⚠️ 留空 = 今天的行为一字不差：**只有** `localhost` / `127.0.0.1` / `[::1]` 走 http。
# ⚠️ 它存在的理由与 SANDBOX_DOCKER_NETWORK 同源：那三个字面量在容器里指的是**容器自己**，
#    所以 compose 形态下配不出可用的本机 registry（换 `host.docker.internal` 又被强制
#    https）。⛔ 平台**不做**「先试 https 再退回 http」的自动降级——那等于给任何一次
#    TLS 故障配一条静默的降级路径。
# ⚠️ 端口是坐标的一部分：放行 `registry.local:15001` 不等于放行 `registry.local:443`。
IMAGE_REGISTRY_INSECURE_HOSTS=

# Access passcode (shared/11 §3.1). Empty = passcode disabled (NoopAuthGuard).
# When set, only the argon2/bcrypt HASH is stored in system_settings in a real deploy.
ACCESS_PASSCODE=
